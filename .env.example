# Commodity Derivatives Intelligence (.env)
# Hack in Hills '26 - Team Holyknight

# Flask Server Configuration
FLASK_APP=backend.app:app
FLASK_ENV=development
PORT=5000
DEBUG=True

# Database Configuration
# Leave SUPABASE_URL empty to use automatic zero-setup local SQLite: backend/data/cdi_local.db
# To connect to Supabase PostgreSQL:
# SUPABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres  WHY YOU USEED THIS THIS IS NOT NICE
SUPABASE_URL=
DATABASE_URL=

# AI Explanation Layer (Anthropic Claude)
# If left empty, the application seamlessly falls back to deterministic quant template explanations.
ANTHROPIC_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000
